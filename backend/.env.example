# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend origin allowed to send session cookies with CSRF-protected requests
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Proxies in front of Django that append the client IP to X-Forwarded-For; sign-in limits
# count per client by it. 0 locally: the header is not trusted at all.
DJANGO_NUM_PROXIES=0

# PostgreSQL (also used by the db container in docker compose)
POSTGRES_DB=gymeri
POSTGRES_USER=gymeri
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
